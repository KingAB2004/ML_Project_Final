{"node_id": "nd002", "text": "To process difficult emotions", "depth": 1, "parent_id": "nd001", "status": "hypothesis", "confidence": 0.9, "confidence_raw": 0.9, "supporting_spans": [{"session_id": "p000076-mem_needstate-s1", "turn_index": 1, "quote": "I've seen some stuff lately that's been... tough to watch.", "char_start": 0, "char_end": 58}, {"session_id": "p000076-mem_needstate-s1", "turn_index": 1, "quote": "Feels wrong somehow.", "char_start": 114, "char_end": 134}, {"session_id": "p000076-mem_needstate-s1", "turn_index": 1, "quote": "I've seen some stuff lately that's been... tough to watch. Like, this kid who got hit by another kid at the park. Feels wrong somehow.", "char_start": 0, "char_end": 134}, {"session_id": "p000076-mem_needstate-s1", "turn_index": 5, "quote": "It's just... uncomfortable, you know? Like, I want kids to be safe, but seeing that, it makes me worry.", "char_start": 0, "char_end": 103}, {"session_id": "p000076-mem_needstate-s2", "turn_index": 1, "quote": "Wondering if I should have said something.", "char_start": 74, "char_end": 116}, {"session_id": "p000076-mem_needstate-s2", "turn_index": 3, "quote": "Yeah, it's just that I feel like I should have done something but didn't want to make a big deal out of it.", "char_start": 0, "char_end": 107}, {"session_id": "p000076-mem_needstate-s2", "turn_index": 3, "quote": "I feel like I should have done something but didn't want to make a big deal out of it.", "char_start": 21, "char_end": 107}], "contradicting_spans": [], "first_seen_at": "20261010T003934Z", "last_updated_at": "20261010T004449Z", "first_seen_session": "p000076-mem_needstate-s1", "last_session": "p000076-mem_needstate-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false, "sessions_seen": 2}
{"node_id": "nd003", "text": "To find meaning in difficult experiences", "depth": 2, "parent_id": "nd002", "status": "hypothesis", "confidence": 0.7, "confidence_raw": 0.7, "supporting_spans": [{"session_id": "p000076-mem_needstate-s1", "turn_index": 1, "quote": "Feels wrong somehow.", "char_start": 114, "char_end": 134}, {"session_id": "p000076-mem_needstate-s1", "turn_index": 1, "quote": "I've seen some stuff lately that's been... tough to watch.", "char_start": 0, "char_end": 58}, {"session_id": "p000076-mem_needstate-s1", "turn_index": 7, "quote": "I just felt... disappointed, you know? Like, why would someone do that to a child? Feels wrong.", "char_start": 0, "char_end": 95}, {"session_id": "p000076-mem_needstate-s1", "turn_index": 11, "quote": "It's just... hard to see that kind of behavior. I wish kids were always safe and cared for.", "char_start": 0, "char_end": 91}, {"session_id": "p000076-mem_needstate-s1", "turn_index": 13, "quote": "It's just... concerning. I worry it might normalize treating kids harshly. But I know not all kids are treated that way.", "char_start": 0, "char_end": 120}, {"session_id": "p000076-mem_needstate-s2", "turn_index": 1, "quote": "Wondering if I should have said something.", "char_start": 74, "char_end": 116}, {"session_id": "p000076-mem_needstate-s2", "turn_index": 1, "quote": "Not much changed. Just been thinking about those times I saw the teacher. Wondering if I should have said something.", "char_start": 0, "char_end": 116}], "contradicting_spans": [], "first_seen_at": "20261010T003934Z", "last_updated_at": "20261010T004449Z", "first_seen_session": "p000076-mem_needstate-s1", "last_session": "p000076-mem_needstate-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false, "sessions_seen": 2}

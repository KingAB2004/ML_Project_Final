{"node_id": "nd003", "text": "to feel competent", "depth": 2, "parent_id": "nd001", "status": "hypothesis", "confidence": 1.0, "confidence_raw": 1.0, "supporting_spans": [{"session_id": "p000508-sft7b_multi_mem-s1", "turn_index": 1, "quote": "I aced my ACT and got the score I worked so hard for. Feels great!", "char_start": 57, "char_end": 123}, {"session_id": "p000508-sft7b_multi_mem-s1", "turn_index": 3, "quote": "Studying those ACT questions for months was tough, but it was worth it to see the score.", "char_start": 34, "char_end": 122}, {"session_id": "p000508-sft7b_multi_mem-s1", "turn_index": 7, "quote": "Yeah, it’s been a long journey, but seeing the result was definitely worth it.", "char_start": 0, "char_end": 78}, {"session_id": "p000508-sft7b_multi_mem-s2", "turn_index": 1, "quote": "压力挺大的", "char_start": 48, "char_end": 53}, {"session_id": "p000508-sft7b_multi_mem-s2", "turn_index": 3, "quote": "But I need to do well to stand out.", "char_start": 74, "char_end": 109}, {"session_id": "p000508-sft7b_multi_mem-s2", "turn_index": 3, "quote": "Studying and writing essays take all my energy. But I need to do well to stand out.", "char_start": 26, "char_end": 109}, {"session_id": "p000508-sft7b_multi_mem-s3", "turn_index": 1, "quote": "Things have been tough. I kept trying to take breaks but found myself just working harder instead.", "char_start": 0, "char_end": 98}, {"session_id": "p000508-sft7b_multi_mem-s3", "turn_index": 3, "quote": "Yeah, it's been a struggle. I feel like I should be able to step back, but every time I try, I just end up cramming even more.", "char_start": 0, "char_end": 126}, {"session_id": "p000508-sft7b_multi_mem-s3", "turn_index": 5, "quote": "It's been hard to pinpoint exactly what triggers it. I just feel like I have to keep pushing because I'm not sure when I'll have another chance.", "char_start": 0, "char_end": 144}, {"session_id": "p000508-sft7b_multi_mem-s3", "turn_index": 13, "quote": "I just feel like I need constant validation that I'm doing enough.", "char_start": 78, "char_end": 144}], "contradicting_spans": [], "first_seen_at": "20261008T092224Z", "last_updated_at": "20261008T092845Z", "first_seen_session": "p000508-sft7b_multi_mem-s1", "last_session": "p000508-sft7b_multi_mem-s3", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false, "sessions_seen": 3}
{"node_id": "nd004", "text": "to be recognized", "depth": 2, "parent_id": "nd001", "status": "hypothesis", "confidence": 1.0, "confidence_raw": 1.0, "supporting_spans": [{"session_id": "p000508-sft7b_multi_mem-s1", "turn_index": 1, "quote": "Feels great!", "char_start": 111, "char_end": 123}, {"session_id": "p000508-sft7b_multi_mem-s1", "turn_index": 1, "quote": "I aced my ACT and got the score I worked so hard for. Feels great!", "char_start": 57, "char_end": 123}, {"session_id": "p000508-sft7b_multi_mem-s1", "turn_index": 1, "quote": "Yeah, it's nice to finally have some good news to share.", "char_start": 0, "char_end": 56}, {"session_id": "p000508-sft7b_multi_mem-s1", "turn_index": 3, "quote": "That's really kind of you to say. Studying those ACT questions for months was tough, but it was worth it to see the score.", "char_start": 0, "char_end": 122}, {"session_id": "p000508-sft7b_multi_mem-s1", "turn_index": 1, "quote": "Yeah, it's nice to finally have some good news to share. I aced my ACT and got the score I worked so hard for. Feels great!", "char_start": 0, "char_end": 123}, {"session_id": "p000508-sft7b_multi_mem-s2", "turn_index": 1, "quote": "最近申请奖学金的截止日期快到了。", "char_start": 32, "char_end": 48}, {"session_id": "p000508-sft7b_multi_mem-s2", "turn_index": 3, "quote": "But I need to do well to stand out.", "char_start": 74, "char_end": 109}, {"session_id": "p000508-sft7b_multi_mem-s2", "turn_index": 9, "quote": "I just need to keep going, hoping it all pays off.", "char_start": 75, "char_end": 125}, {"session_id": "p000508-sft7b_multi_mem-s3", "turn_index": 1, "quote": "Things have been tough. I kept trying to take breaks but found myself just working harder instead.", "char_start": 0, "char_end": 98}, {"session_id": "p000508-sft7b_multi_mem-s3", "turn_index": 5, "quote": "It's been hard to pinpoint exactly what triggers it. I just feel like I have to keep pushing because I'm not sure when I'll have another chance.", "char_start": 0, "char_end": 144}, {"ses
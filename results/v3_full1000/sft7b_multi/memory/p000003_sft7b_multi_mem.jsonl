{"node_id": "nd004", "text": "To feel valued", "depth": 3, "parent_id": "nd002", "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000003-sft7b_multi_mem-s1", "turn_index": 3, "quote": "LeBron leaving for LA hit me hard. Feels like he doesn't value me anymore.", "char_start": 0, "char_end": 74}, {"session_id": "p000003-sft7b_multi_mem-s1", "turn_index": 9, "quote": "Breaking it down helps a bit, but it still feels like nothing matters. Like he chose LA over me.", "char_start": 27, "char_end": 123}, {"session_id": "p000003-sft7b_multi_mem-s1", "turn_index": 17, "quote": "I appreciate the suggestion, but it’s hard when it feels like he values the city more than he does me. Even when there are small wins, it still feels like they’re not enough.", "char_start": 0, "char_end": 174}, {"session_id": "p000003-sft7b_multi_mem-s2", "turn_index": 1, "quote": "Still missing him, but finding little things to appreciate now.", "char_start": 26, "char_end": 89}, {"session_id": "p000003-sft7b_multi_mem-s2", "turn_index": 5, "quote": "Thanks for checking in. Yeah, those small things do help, even if the sadness lingers. I'm trying to focus on them.", "char_start": 0, "char_end": 115}, {"session_id": "p000003-sft7b_multi_mem-s2", "turn_index": 7, "quote": "That's kind of you to say. It does help, even if it feels small sometimes.", "char_start": 0, "char_end": 74}, {"session_id": "p000003-sft7b_multi_mem-s2", "turn_index": 11, "quote": "Thanks, it means a lot to hear that.", "char_start": 0, "char_end": 36}], "contradicting_spans": [], "first_seen_at": "20261008T072801Z", "last_updated_at": "20261008T073237Z", "first_seen_session": "p000003-sft7b_multi_mem-s1", "last_session": "p000003-sft7b_multi_mem-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false, "sessions_seen": 2}
{"node_id": "nd005", "text": "To feel competent", "depth": 2, "parent_id": "nd003", "status": "hypothesis", "confidence": 0.42, "confidence_raw": 0.42, "supporting_spans": [{"session_id": "p000003-sft7b_multi_mem-s1", "turn_index": 3, "quote": "LeBron leaving for LA hit me hard. Feels like he doesn't value me anymore.", "char_start": 0, "char_end": 74}, {"session_id": "p000003-sft7b_multi_mem-s1", "turn_index": 7, "quote": "Do you have any tips on how to cope?", "char_start": 68, "char_end": 104}, {"session_id": "p000003-sft7b_multi_mem-s1", "turn_index": 9, "quote": "Breaking it down helps a bit, but it still feels like nothing matters. Like he chose LA over me.", "char_start": 27, "char_end": 123}, {"session_id": "p000003-sft7b_multi_mem-s1", "turn_index": 11, "quote": "It's hard to find any small wins when it feels like he didn't even see me.", "char_start": 0, "char_end": 74}, {"session_id": "p000003-sft7b_multi_mem-s1", "turn_index": 15, "quote": "It's hard to find anything to be grateful for when it feels like he values LA more than he does me.", "char_start": 0, "char_end": 99}, {"session_id": "p000003-sft7b_multi_mem-s1", "turn_index": 19, "quote": "It's hard because it feels like every time I try, it's not enough compared to LA. Even when I succeed, it still feels like it’s not good enough.", "char_start": 0, "char_end": 144}, {"session_id": "p000003-sft7b_multi_mem-s2", "turn_index": 3, "quote": "It helps, but the sadness is still there too.", "char_start": 60, "char_end": 105}, {"session_id": "p000003-sft7b_multi_mem-s2", "turn_index": 5, "quote": "Thanks for checking in. Yeah, those small things do help, even if the sadness lingers. I'm trying to focus on them.", "char_start": 0, "char_end": 115}, {"session_id": "p000003-sft7b_multi_mem-s2", "turn_index": 3, "quote": "Yeah, I've noticed a few small things lately that are nice. It helps, but the sadness is still there too.", "char_start": 0, "char_end": 105}], "contradicting_spans": [], "first_seen_at": "20261008T072816Z", "last_updated_at": "20261008T073237Z", "first_seen_session": "p000003-sft7b_multi_mem-s1", "last_session": "p000003-sft7b_multi_mem-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false, "sessions_seen": 2}

{"node_id": "nd001", "text": "feels anxious", "depth": 0, "parent_id": null, "status": "hypothesis", "confidence": 0.9, "confidence_raw": 0.9, "supporting_spans": [{"session_id": "p000327-sft7b_multi_mem-s1", "turn_index": 1, "quote": "Just a busy day, you know how it is.", "char_start": 9, "char_end": 45}, {"session_id": "p000327-sft7b_multi_mem-s2", "turn_index": 1, "quote": "Things have been… okay, I guess. Just trying to keep busy and not think too much.", "char_start": 0, "char_end": 81}, {"session_id": "p000327-sft7b_multi_mem-s3", "turn_index": 1, "quote": "Not much changed. Just trying to keep busy and stay resilient, you know?", "char_start": 0, "char_end": 72}, {"session_id": "p000327-sft7b_multi_mem-s3", "turn_index": 5, "quote": "I set goals, but sometimes they just feel like another thing to fail at. It's hard when I try and still feel alone.", "char_start": 0, "char_end": 115}, {"session_id": "p000327-sft7b_multi_mem-s4", "turn_index": 1, "quote": "Not much, same old. Just feeling... wary, I guess.", "char_start": 0, "char_end": 50}, {"session_id": "p000327-sft7b_multi_mem-s4", "turn_index": 1, "quote": "It's hard to trust again.", "char_start": 51, "char_end": 76}], "contradicting_spans": [], "first_seen_at": "20261008T093944Z", "last_updated_at": "20261008T095203Z", "first_seen_session": "p000327-sft7b_multi_mem-s1", "last_session": "p000327-sft7b_multi_mem-s4", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false, "sessions_seen": 4}

{"node_id": "nd001", "text": "Need for emotional support", "depth": 1, "parent_id": null, "status": "confirmed", "confidence": 0.9, "confidence_raw": 0.9, "supporting_spans": [{"session_id": "p000442-mem_needstate-s1", "turn_index": 1, "quote": "Morning. Just had a rough day with the kids. Everything is okay, though.", "char_start": 0, "char_end": 72}, {"session_id": "p000442-mem_needstate-s1", "turn_index": 1, "quote": "Just had a rough day with the kids.", "char_start": 9, "char_end": 44}, {"session_id": "p000442-mem_needstate-s1", "turn_index": 3, "quote": "It's not just today, you know. It's been tough lately.", "char_start": 0, "char_end": 54}, {"session_id": "p000442-mem_needstate-s1", "turn_index": 7, "quote": "It's just that every little thing seems to pile up. I try my best, but... those moments feel like failures.", "char_start": 0, "char_end": 107}, {"session_id": "p000442-mem_needstate-s1", "turn_index": 9, "quote": "It's just that when I screw up, it feels like I'm failing her. I try my best, but those moments stick with me.", "char_start": 0, "char_end": 110}], "contradicting_spans": [], "first_seen_at": "20261006T194747Z", "last_updated_at": "20261006T194933Z", "first_seen_session": "p000442-mem_needstate-s1", "last_session": "p000442-mem_needstate-s1", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}
{"node_id": "nd002", "text": "Need for validation", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000442-mem_needstate-s1", "turn_index": 1, "quote": "Everything is okay, though.", "char_start": 45, "char_end": 72}, {"session_id": "p000442-mem_needstate-s1", "turn_index": 3, "quote": "How silly of me!", "char_start": 171, "char_end": 187}, {"session_id": "p000442-mem_needstate-s1", "turn_index": 5, "quote": "Yeah, it's not the first time I've let her down. Last week, I forgot her dry cleaning, and a few months ago, I missed the mall trip. But yesterday, I could have helped with homework—she was really struggling.", "char_start": 0, "char_end": 208}, {"session_id": "p000442-mem_needstate-s1", "turn_index": 3, "quote": "It's not just today, you know. It's been tough lately.", "char_start": 0, "char_end": 54}, {"session_id": "p000442-mem_needstate-s1", "turn_index": 3, "quote": "I think I made a mistake at dinner time. I ate my daughter's McDonald's order instead of helping her with homework. How silly of me!", "char_start": 55, "char_end": 187}, {"session_id": "p000442-mem_needstate-s1", "turn_index": 9, "quote": "those moments stick with me.", "char_start": 82, "char_end": 110}, {"session_id": "p000442-mem_needstate-s2", "turn_index": 1, "quote": "I keep feeling like I'm failing her in some way.", "char_start": 32, "char_end": 80}, {"session_id": "p000442-mem_needstate-s2", "turn_index": 9, "quote": "But those moments are few and far between.", "char_start": 70, "char_end": 112}, {"session_id": "p000442-mem_needstate-s2", "turn_index": 11, "quote": "I remember when she made me breakfast in bed last birthday. It was small, but it felt really good to see her happy and thinking of me.", "char_start": 0, "char_end": 134}, {"session_id": "p000442-mem_needstate-s2", "turn_index": 5, "quote": "I hate that I can't do better.", "char_start": 152, "char_end": 182}, {"session_id": "p000442-mem_needstate-s3", "turn_index": 1, "quote": "Just dealing with the usual stuff, you know?", "char_start": 23, "char_end": 67}, {"session_id": "p000442-mem_needstate-s3", "turn_index": 3, "quote": "Thanks for asking.", "char_start": 53, "char_end": 71}, {"session_id": "p000442-mem_needstate-s3", "turn_index": 5, "quote": "It's just... there are days when I feel like I could be doing more for her. You know? Like, really being there.", "char_start": 12, "char_end": 123}, {"session_id": "p000442-mem_needstate-s3", "turn_index": 7, "quote": "So I guess small things do matter.", "char_start": 191, "char_end": 225}, {"session_id": "p000442-mem_needstate-s3", "turn_index": 9, "quote": "Thanks. I guess small actions can add up, you know?", "char_start": 0, "char_end": 51}, {"session_id": "p000442-mem_needstate-s3", "turn_index": 9, "quote": "Thanks. I guess small actions can add up, you know? It's just hard to see sometimes.", "char_start": 0, "char_end": 84}], "contradicting_spans": [], "first_seen_at": "20261006T194747Z", "last_updated_at": "20261006T195822Z", "first_seen_session": "p000442-mem_needstate-s1", "last_session": "p000442-mem_needstate-s3", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}

{"node_id": "nd005", "text": "Acknowledgment", "depth": 2, "parent_id": null, "status": "hypothesis", "confidence": 0.6, "confidence_raw": 0.6, "supporting_spans": [{"session_id": "p000181-mem_needstate-s2", "turn_index": 11, "quote": "Thanks, maybe I'll try a short walk during their nap.", "char_start": 0, "char_end": 53}, {"session_id": "p000181-mem_needstate-s2", "turn_index": 7, "quote": "I think I just need a break sometimes.", "char_start": 57, "char_end": 95}, {"session_id": "p000181-mem_needstate-s2", "turn_index": 9, "quote": "I do need some time to myself, even if just for a little while.", "char_start": 24, "char_end": 87}, {"session_id": "p000181-mem_needstate-s2", "turn_index": 7, "quote": "It's weird, I should feel happy, but the guilt is there.", "char_start": 0, "char_end": 56}, {"session_id": "p000181-mem_needstate-s3", "turn_index": 3, "quote": "Like, am I a bad parent for enjoying that silence?", "char_start": 122, "char_end": 172}, {"session_id": "p000181-mem_needstate-s3", "turn_index": 5, "quote": "It feels like a strange relief, but also guilty.", "char_start": 0, "char_end": 48}, {"session_id": "p000181-mem_needstate-s3", "turn_index": 5, "quote": "I just need some time alone, I think. But I worry about neglecting my kids.", "char_start": 49, "char_end": 124}, {"session_id": "p000181-mem_needstate-s3", "turn_index": 9, "quote": "I mean, I want to be a good parent, but sometimes I feel like I'm failing.", "char_start": 39, "char_end": 113}, {"session_id": "p000181-mem_needstate-s3", "turn_index": 11, "quote": "But I guess you're right; I do need to take care of myself too.", "char_start": 73, "char_end": 136}], "contradicting_spans": [], "first_seen_at": "20261006T175246Z", "last_updated_at": "20261006T175712Z", "first_seen_session": "p000181-mem_needstate-s2", "last_session": "p000181-mem_needstate-s3", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}

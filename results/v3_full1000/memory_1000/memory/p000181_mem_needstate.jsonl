{"node_id": "nd002", "text": "Work-Life Balance", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000181-mem_needstate-s1", "turn_index": 1, "quote": "Work’s been hectic", "char_start": 32, "char_end": 50}, {"session_id": "p000181-mem_needstate-s1", "turn_index": 3, "quote": "It’s not just the quiet, though. I mean, I do need that, but sometimes I feel like I shouldn’t want it so much.", "char_start": 0, "char_end": 111}, {"session_id": "p000181-mem_needstate-s1", "turn_index": 1, "quote": "Work’s been hectic, and I guess I just enjoy the quiet when they’re asleep.", "char_start": 32, "char_end": 107}, {"session_id": "p000181-mem_needstate-s1", "turn_index": 3, "quote": "It’s not just the quiet, though.", "char_start": 0, "char_end": 32}, {"session_id": "p000181-mem_needstate-s2", "turn_index": 1, "quote": "Just trying to get through the day.", "char_start": 36, "char_end": 71}, {"session_id": "p000181-mem_needstate-s2", "turn_index": 3, "quote": "It’s been tough. I mean, I kind of look forward to the kids napping, you know? But I shouldn't.", "char_start": 0, "char_end": 95}, {"session_id": "p000181-mem_needstate-s2", "turn_index": 5, "quote": "It’s just... exhausting.", "char_start": 92, "char_end": 116}, {"session_id": "p000181-mem_needstate-s3", "turn_index": 1, "quote": "Just feeling more anxious about enjoying the quiet times.", "char_start": 36, "char_end": 93}, {"session_id": "p000181-mem_needstate-s3", "turn_index": 1, "quote": "Things have been the same, I guess. Just feeling more anxious about enjoying the quiet times.", "char_start": 0, "char_end": 93}, {"session_id": "p000181-mem_needstate-s3", "turn_index": 7, "quote": "It's hard not to feel guilty when I look forward to those moments.", "char_start": 51, "char_end": 117}, {"session_id": "p000181-mem_needstate-s3", "turn_index": 7, "quote": "Yeah, I just need to figure out how to balance it.", "char_start": 0, "char_end": 50}], "contradicting_spans": [], "first_seen_at": "20261006T174748Z", "last_updated_at": "20261006T175712Z", "first_seen_session": "p000181-mem_needstate-s1", "last_session": "p000181-mem_needstate-s3", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}
{"node_id": "nd003", "text": "Self-Care", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000181-mem_needstate-s1", "turn_index": 7, "quote": "Maybe setting some personal time can help?", "char_start": 73, "char_end": 115}, {"session_id": "p000181-mem_needstate-s1", "turn_index": 3, "quote": "I do need that, but sometimes I feel like I shouldn’t want it so much.", "char_start": 41, "char_end": 111}, {"session_id": "p000181-mem_needstate-s2", "turn_index": 1, "quote": "Just trying to get through the day.", "char_start": 36, "char_end": 71}, {"session_id": "p000181-mem_needstate-s2", "turn_index": 3, "quote": "It’s been tough. I mean, I kind of look forward to the kids napping, you know? But I shouldn't.", "char_start": 0, "char_end": 95}, {"session_id": "p000181-mem_needstate-s2", "turn_index": 5, "quote": "I do look forward to it, but then I feel guilty for enjoying that quiet time.", "char_start": 14, "char_end": 91}, {"session_id": "p000181-mem_needstate-s2", "turn_index": 7, "quote": "I think I just need a break sometimes.", "char_start": 57, "char_end": 95}, {"session_id": "p000181-mem_needstate-s2", "turn_index": 9, "quote": "I do need some time to myself, even if just for a little while.", "char_start": 24, "char_end": 87}, {"session_id": "p000181-mem_needstate-s2", "turn_index": 15, "quote": "Maybe starting small is a good idea.", "char_start": 32, "char_end": 68}, {"session_id": "p000181-mem_needstate-s2", "turn_index": 11, "quote": "But I worry it won't be enough.", "char_start": 54, "char_end": 85}], "contradicting_spans": [], "first_seen_at": "20261006T174854Z", "last_updated_at": "20261006T175415Z", "first_seen_session": "p000181-mem_needstate-s1", "last_session": "p000181-mem_needstate-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}

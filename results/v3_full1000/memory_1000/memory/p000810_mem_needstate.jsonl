{"node_id": "nd001", "text": "Validation of feelings", "depth": 1, "parent_id": null, "status": "confirmed", "confidence": 0.9, "confidence_raw": 0.9, "supporting_spans": [{"session_id": "p000810-mem_needstate-s1", "turn_index": 1, "quote": "It's just been a year since she passed. Hard to believe.", "char_start": 0, "char_end": 56}, {"session_id": "p000810-mem_needstate-s1", "turn_index": 5, "quote": "I was actually thinking about our birthday celebration last year. It felt so normal, you know? Just the two of us.", "char_start": 0, "char_end": 114}], "contradicting_spans": [], "first_seen_at": "20261006T162108Z", "last_updated_at": "20261006T162218Z", "first_seen_session": "p000810-mem_needstate-s1", "last_session": "p000810-mem_needstate-s1", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}
{"node_id": "nd002", "text": "Support in processing emotions", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000810-mem_needstate-s1", "turn_index": 1, "quote": "It's just been a year since she passed. Hard to believe.", "char_start": 0, "char_end": 56}, {"session_id": "p000810-mem_needstate-s1", "turn_index": 3, "quote": "Yeah, it feels like it just happened.", "char_start": 0, "char_end": 37}, {"session_id": "p000810-mem_needstate-s1", "turn_index": 5, "quote": "I was actually thinking about our birthday celebration last year. It felt so normal, you know? Just the two of us.", "char_start": 0, "char_end": 114}, {"session_id": "p000810-mem_needstate-s1", "turn_index": 7, "quote": "It helped to feel close to her for a bit.", "char_start": 60, "char_end": 101}, {"session_id": "p000810-mem_needstate-s2", "turn_index": 1, "quote": "Things have been... tough, I guess.", "char_start": 0, "char_end": 35}, {"session_id": "p000810-mem_needstate-s2", "turn_index": 1, "quote": "Things have been... tough, I guess. It feels like it's been a while since we last spoke.", "char_start": 0, "char_end": 88}, {"session_id": "p000810-mem_needstate-s2", "turn_index": 9, "quote": "I try to focus on the good times, but some days it's hard.", "char_start": 20, "char_end": 78}, {"session_id": "p000810-mem_needstate-s2", "turn_index": 11, "quote": "Thanks for listening though.", "char_start": 79, "char_end": 107}, {"session_id": "p000810-mem_needstate-s2", "turn_index": 11, "quote": "It's nice to think about the good times, but some days it's just overwhelming.", "char_start": 0, "char_end": 78}, {"session_id": "p000810-mem_needstate-s3", "turn_index": 9, "quote": "Those conversations bring back good memories, but they also remind me of her absence. It's hard to keep going like this.", "char_start": 0, "char_end": 120}, {"session_id": "p000810-mem_needstate-s3", "turn_index": 7, "quote": "It's those con
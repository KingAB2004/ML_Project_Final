{"node_id": "nd001", "text": "feels overwhelmed", "depth": 0, "parent_id": null, "status": "hypothesis", "confidence": 0.9, "confidence_raw": 0.9, "supporting_spans": [{"session_id": "p000962-sft_dec_gated_mem-s1", "turn_index": 1, "quote": "Last week was rough with my friend's accident. Feels like things are spiraling.", "char_start": 46, "char_end": 125}, {"session_id": "p000962-sft_dec_gated_mem-s1", "turn_index": 3, "quote": "My partner and work... it’s all piling up.", "char_start": 64, "char_end": 106}, {"session_id": "p000962-sft_dec_gated_mem-s1", "turn_index": 5, "quote": "It's just overwhelming. Every little thing reminds me of that accident. Feeling like I’m losing control.", "char_start": 0, "char_end": 104}, {"session_id": "p000962-sft_dec_gated_mem-s2", "turn_index": 1, "quote": "Things have been really tough.", "char_start": 0, "char_end": 30}, {"session_id": "p000962-sft_dec_gated_mem-s2", "turn_index": 1, "quote": "Things have been really tough. My friend's accident last week really shook me up. Work stress hasn't helped either.", "char_start": 0, "char_end": 115}], "contradicting_spans": [], "first_seen_at": "20261016T142523Z", "last_updated_at": "20261016T143249Z", "first_seen_session": "p000962-sft_dec_gated_mem-s1", "last_session": "p000962-sft_dec_gated_mem-s2", "blocked_from_reproposal": false, "reinstated_count": 1, "dormant": false, "sessions_seen": 2}
{"node_id": "nd002", "text": "To process grief", "depth": 2, "parent_id": "nd001", "status": "hypothesis", "confidence": 0.11585334547783263, "confidence_raw": 0.7, "supporting_spans": [{"session_id": "p000962-sft_dec_gated_mem-s1", "turn_index": 1, "quote": "Last week was rough with my friend's accident. Feels like things are spiraling.", "char_start": 46, "char_end": 125}, {"session_id": "p000962-sft_dec_gated_mem-s1", "turn_index": 1, "quote": "Last week was rough with my friend's accident.", "char_start": 46, "char_end": 92}, {"session_id": "p000962-sft_dec_gated_mem-s1", "turn_index": 3, "quote": "And now everything else feels unstable too. My partner and work... it’s all piling up.", "char_start": 20, "char_end": 106}, {"session_id": "p000962-sft_dec_gated_mem-s1", "turn_index": 7, "quote": "The accident triggered some old fears, you know? Like when my parents divorced. It all makes me panic.", "char_start": 0, "char_end": 102}, {"session_id": "p000962-sft_dec_gated_mem-s1", "turn_index": 1, "quote": "Hey, just needed someone to talk to, I guess.", "char_start": 0, "char_end": 45}, {"session_id": "p000962-sft_dec_gated_mem-s1", "turn_index": 7, "quote": "The accident triggered some old fears, you know? Like when my parents divorced. It all makes me panic. Work stress and fighting with my partner... it’s all too much.", "char_start": 0, "char_end": 165}, {"session_id": "p000962-sft_dec_gated_mem-s1", "turn_index": 1, "quote": "Hey, just needed someone to talk to, I guess. Last week was rough with my friend's accident. Feels like things are spiraling.", "char_start": 0, "char_end": 125}], "contradicting_spans": [], "first_seen_at": "20261016T142523Z", "last_updated_at": "20261016T142819Z", "first_seen_session": "p000962-sft_dec_gated_mem-s1", "last_session": "p000962-sft_dec_gated_mem-s1", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": true, "sessions_seen": 1}

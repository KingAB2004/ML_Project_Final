{"node_id": "nd005", "text": "To feel competent", "depth": 2, "parent_id": "nd004", "status": "hypothesis", "confidence": 0.7, "confidence_raw": 0.7, "supporting_spans": [{"session_id": "p000393-sft_dec_gated_mem-s1", "turn_index": 7, "quote": "Like last week, I pretended to be sick to go to work. I really needed that day off, but now I feel like I betrayed my colleagues' trust.", "char_start": 65, "char_end": 201}, {"session_id": "p000393-sft_dec_gated_mem-s1", "turn_index": 11, "quote": "It’s frustrating because I try so hard to be dependable.", "char_start": 0, "char_end": 56}, {"session_id": "p000393-sft_dec_gated_mem-s1", "turn_index": 11, "quote": "But that one time still haunts me. I wonder if I’ll ever fully shake this feeling.", "char_start": 57, "char_end": 139}, {"session_id": "p000393-sft_dec_gated_mem-s2", "turn_index": 5, "quote": "But maybe they didn't notice at all.", "char_start": 108, "char_end": 144}, {"session_id": "p000393-sft_dec_gated_mem-s2", "turn_index": 7, "quote": "Maybe I just need to focus on being honest moving forward.", "char_start": 112, "char_end": 170}, {"session_id": "p000393-sft_dec_gated_mem-s2", "turn_index": 9, "quote": "I guess I just need to remind myself that I can't control how everyone else feels, only my own actions from now on.", "char_start": 18, "char_end": 133}, {"session_id": "p000393-sft_dec_gated_mem-s2", "turn_index": 7, "quote": "Sometimes I wish I could just stop overthinking it. But I know I can't change what happened. Maybe I just need to focus on being honest moving forward.", "char_start": 19, "char_end": 170}], "contradicting_spans": [], "first_seen_at": "20261016T155940Z", "last_updated_at": "20261016T160432Z", "first_seen_session": "p000393-sft_dec_gated_mem-s1", "last_session": "p000393-sft_dec_gated_mem-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false, "sessions_seen": 2}
{"node_id": "nd006", "text": "feels guilty", "depth": 0, "parent_id": null, "status": "hypothesis", "confidence": 0.9, "confidence_raw": 0.9, "supporting_spans": [{"session_id": "p000393-sft_dec_gated_mem-s1", "turn_index": 7, "quote": "Sometimes, guilt just sticks around, even when things seem fine.", "char_start": 0, "char_end": 64}, {"session_id": "p000393-sft_dec_gated_mem-s1", "turn_index": 7, "quote": "Like last week, I pretended to be sick to go to work. I really needed that day off, but now I feel like I betrayed my colleagues' trust.", "char_start": 65, "char_end": 201}, {"session_id": "p000393-sft_dec_gated_mem-s1", "turn_index": 5, "quote": "Do you ever feel guilty even when everything seems fine?", "char_start": 80, "char_end": 136}, {"session_id": "p000393-sft_dec_gated_mem-s2", "turn_index": 1, "quote": "The guilt still lingers. Every time I think of how I deceived everyone, I feel worse.", "char_start": 24, "char_end": 109}], "contradicting_spans": [], "first_seen_at": "20261016T160008Z", "last_updated_at": "20261016T160456Z", "first_seen_session": "p000393-sft_dec_gated_mem-s1", "last_session": "p000393-sft_dec_gated_mem-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false, "sessions_seen": 2}

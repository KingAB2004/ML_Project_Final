{"node_id": "nd002", "text": "To avoid thinking about problems", "depth": 2, "parent_id": "nd001", "status": "hypothesis", "confidence": 0.7, "confidence_raw": 0.7, "supporting_spans": [{"session_id": "p000393-sft_dec_gated_mem-s1", "turn_index": 1, "quote": "I'm managing, just keeping busy.", "char_start": 0, "char_end": 32}, {"session_id": "p000393-sft_dec_gated_mem-s1", "turn_index": 5, "quote": "My day has been mostly routine, but there’s this nagging feeling I can’t shake.", "char_start": 0, "char_end": 79}, {"session_id": "p000393-sft_dec_gated_mem-s2", "turn_index": 1, "quote": "Every time I think of how I deceived everyone, I feel worse.", "char_start": 49, "char_end": 109}, {"session_id": "p000393-sft_dec_gated_mem-s2", "turn_index": 3, "quote": "But maybe they noticed and thought I just had a bad day.", "char_start": 62, "char_end": 118}, {"session_id": "p000393-sft_dec_gated_mem-s2", "turn_index": 5, "quote": "It's just that thinking about it all the time makes me feel even more responsible for their disappointment.", "char_start": 0, "char_end": 107}, {"session_id": "p000393-sft_dec_gated_mem-s2", "turn_index": 5, "quote": "It's just that thinking about it all the time makes me feel even more responsible for their disappointment. But maybe they didn't notice at all.", "char_start": 0, "char_end": 144}], "contradicting_spans": [], "first_seen_at": "20261016T155836Z", "last_updated_at": "20261016T160456Z", "first_seen_session": "p000393-sft_dec_gated_mem-s1", "last_session": "p000393-sft_dec_gated_mem-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false, "sessions_seen": 2}
{"node_id": "nd003", "text": "To maintain control", "depth": 2, "parent_id": "nd001", "status": "hypothesis", "confidence": 0.6, "confidence_raw": 0.6, "supporting_spans": [{"session_id": "p000393-sft_dec_gated_mem-s1", "turn_index": 1, "quote": "I'm managing, just keeping busy.", "char_start": 0, "char_end": 32}, {"session_id": "p000393-sft_dec_gated_mem-s1", "turn_index": 5, "quote": "My day has been mostly routine, but there’s this nagging feeling I can’t shake.", "char_start": 0, "char_end": 79}, {"session_id": "p000393-sft_dec_gated_mem-s1", "turn_index": 7, "quote": "Sometimes, guilt just sticks around, even when things seem fine.", "char_start": 0, "char_end": 64}, {"session_id": "p000393-sft_dec_gated_mem-s1", "turn_index": 13, "quote": "I guess I’m just hoping it doesn’t keep happening.", "char_start": 161, "char_end": 211}, {"session_id": "p000393-sft_dec_gated_mem-s2", "turn_index": 1, "quote": "Every time I think of how I deceived everyone, I feel worse.", "char_start": 49, "char_end": 109}], "contradicting_spans": [], "first_seen_at": "20261016T155836Z", "last_updated_at": "20261016T160141Z", "first_seen_session": "p000393-sft_dec_gated_mem-s1", "last_session": "p000393-sft_dec_gated_mem-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false, "sessions_seen": 2}

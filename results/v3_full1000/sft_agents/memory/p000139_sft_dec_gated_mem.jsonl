{"node_id": "nd007", "text": "To feel understood", "depth": 2, "parent_id": "nd005", "status": "confirmed", "confidence": 0.9, "confidence_raw": 0.9, "supporting_spans": [{"session_id": "p000139-sft_dec_gated_mem-s2", "turn_index": 1, "quote": "Yeah, it's been tough.", "char_start": 0, "char_end": 22}, {"session_id": "p000139-sft_dec_gated_mem-s2", "turn_index": 3, "quote": "Helps to talk about it, though.", "char_start": 70, "char_end": 101}, {"session_id": "p000139-sft_dec_gated_mem-s2", "turn_index": 1, "quote": "Yeah, it's been tough. Still struggling with drinking a bit. Not sure how to break the cycle.", "char_start": 0, "char_end": 93}, {"session_id": "p000139-sft_dec_gated_mem-s2", "turn_index": 5, "quote": "Yeah, I feel stuck. Tried meditation, but it’s just one more thing that doesn’t work. Just want to feel better without relying on drinking.", "char_start": 0, "char_end": 139}, {"session_id": "p000139-sft_dec_gated_mem-s2", "turn_index": 3, "quote": "I've tried cutting back, but ends up feeling like failure every time. Helps to talk about it, though.", "char_start": 0, "char_end": 101}, {"session_id": "p000139-sft_dec_gated_mem-s3", "turn_index": 1, "quote": "Not thinking much about it.", "char_start": 41, "char_end": 68}, {"session_id": "p000139-sft_dec_gated_mem-s3", "turn_index": 3, "quote": "How about you?", "char_start": 76, "char_end": 90}, {"session_id": "p000139-sft_dec_gated_mem-s3", "turn_index": 3, "quote": "Not really thinking about it much.", "char_start": 41, "char_end": 75}, {"session_id": "p000139-sft_dec_gated_mem-s3", "turn_index": 13, "quote": "Do you understand?", "char_start": 108, "char_end": 126}, {"session_id": "p000139-sft_dec_gated_mem-s4", "turn_index": 1, "quote": "It's been tough. The last few days were a mix of anxiety and trying to stick to my plan. Still struggling with that promise to cut back.", "char_start": 0, "char_end": 136}, {"session_id": "p000139-sft_dec_gated_mem-s4", "turn_index": 5, "quote": "But I appreciate you understanding.", "char_start": 42, "char_end": 77}, {"session_id": "p000139-sft_dec_gated_mem-s4", "turn_index": 7, "quote": "But I'm trying to focus on better choices.", "char_start": 93, "char_end": 135}], "contradicting_spans": [], "first_seen_at": "20261016T123445Z", "last_updated_at": "20261016T124725Z", "first_seen_session": "p000139-sft_dec_gated_mem-s2", "last_session": "p000139-sft_dec_gated_mem-s4", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false, "sessions_seen": 3}

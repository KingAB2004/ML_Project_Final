{"node_id": "nd005", "text": "To be acknowledged", "depth": 2, "parent_id": "nd001", "status": "hypothesis", "confidence": 0.6, "confidence_raw": 0.6, "supporting_spans": [{"session_id": "p000864-sft_dec_gated_mem-s1", "turn_index": 11, "quote": "Sometimes it’s hard to shake off those self-doubts, though.", "char_start": 32, "char_end": 91}, {"session_id": "p000864-sft_dec_gated_mem-s1", "turn_index": 13, "quote": "It helps to hear that. I just wish I could get that recognition and praise sometimes.", "char_start": 0, "char_end": 85}, {"session_id": "p000864-sft_dec_gated_mem-s1", "turn_index": 11, "quote": "Sometimes it’s hard to shake off those self-doubts, though. Thanks for listening.", "char_start": 32, "char_end": 113}, {"session_id": "p000864-sft_dec_gated_mem-s2", "turn_index": 1, "quote": "Just working hard and trying to meet those expectations again.", "char_start": 23, "char_end": 85}, {"session_id": "p000864-sft_dec_gated_mem-s2", "turn_index": 5, "quote": "It’s tough, you know? I feel like I should be doing better, even though I am working hard.", "char_start": 0, "char_end": 90}, {"session_id": "p000864-sft_dec_gated_mem-s2", "turn_index": 7, "quote": "It's just...sometimes I feel like I'm not meeting everyone's expectations, even though I'm putting in the effort. It's frustrating.", "char_start": 19, "char_end": 150}, {"session_id": "p000864-sft_dec_gated_mem-s2", "turn_index": 9, "quote": "I guess I just need to remind myself that it's okay to not always hit every goal perfectly.", "char_start": 33, "char_end": 124}, {"session_id": "p000864-sft_dec_gated_mem-s2", "turn_index": 9, "quote": "Thanks for checking in.", "char_start": 125, "char_end": 148}, {"session_id": "p000864-sft_dec_gated_mem-s3", "turn_index": 1, "quote": "How about you?", "char_start": 62, "char_end": 76}, {"session_id": "p000864-sft_dec_gated_mem-s3", "turn_index": 7, "quote": "Thanks for checking in.", "char_start": 41, "char_end": 64}, {"session_id": "p000864-sft_dec_gated_mem-s4", "turn_index": 1, "quote": "Not sure if I’ll get the grades I want though.", "char_start": 53, "char_end": 99}, {"session_id": "p000864-sft_dec_gated_mem-s4", "turn_index": 3, "quote": "But every time I do well, I still feel a bit disappointed.", "char_start": 102, "char_end": 160}, {"session_id": "p000864-sft_dec_gated_mem-s4", "turn_index": 5, "quote": "It feels like I should be doing better, even when I do well. The pressure is real.", "char_start": 0, "char_end": 82}, {"session_id": "p000864-sft_dec_gated_mem-s4", "turn_index": 7, "quote": "The pressure makes me feel like I’m not good enough, even when I perform well.", "char_start": 0, "char_end": 78}, {"session_id": "p000864-sft_dec_gated_mem-s4", "turn_index": 5, "quote": "It feels like I should be doing better, even when I do well.", "char_start": 0, "char_end": 60}, {"session_id": "p000864-sft_dec_gated_mem-s4", "turn_index": 11, "quote": "I remind myself of my progress, but the fear of not meeting expectations lingers. I just wish I could feel more confident in my abilities.", "char_start": 0, "char_end": 138}, {"session_id": "p000864-sft_dec_gated_mem-s4", "turn_index": 11, "quote": "I just wish I could feel more confident in my abilities.", "char_start": 82, "char_end": 138}], "contradicting_spans": [], "first_seen_at": "20261017T075623Z", "last_updated_at": "20261017T081037Z", "first_seen_session": "p000864-sft_dec_gated_mem-s1", "last_session": "p000864-sft_dec_gated_mem-s4", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false, "sessions_seen": 4}

{"node_id": "nd008", "text": "To feel competent", "depth": 2, "parent_id": "nd014", "status": "hypothesis", "confidence": 0.4, "confidence_raw": 0.4, "supporting_spans": [{"session_id": "p000901-sft_dec_gated_mem-s1", "turn_index": 9, "quote": "It does feel ridiculous. I just want to trust people again, you know? But this all seems so out of control.", "char_start": 0, "char_end": 107}, {"session_id": "p000901-sft_dec_gated_mem-s1", "turn_index": 11, "quote": "I just wish I could feel like I had control again. Every time I think I'm getting somewhere, something else throws me off.", "char_start": 0, "char_end": 122}, {"session_id": "p000901-sft_dec_gated_mem-s2", "turn_index": 13, "quote": "Every day feels like I'm swimming upstream. I need to feel in control again, like I had before.", "char_start": 35, "char_end": 130}, {"session_id": "p000901-sft_dec_gated_mem-s2", "turn_index": 15, "quote": "Every day feels like a struggle, but I guess that's the reality right now.", "char_start": 0, "char_end": 74}, {"session_id": "p000901-sft_dec_gated_mem-s2", "turn_index": 17, "quote": "Every day feels like a struggle, but I'll keep pushing forward, one day at a time. I just need to find my footing again.", "char_start": 0, "char_end": 120}, {"session_id": "p000901-sft_dec_gated_mem-s2", "turn_index": 7, "quote": "But it’s hard to keep doing it when everything feels so broken.", "char_start": 67, "char_end": 130}, {"session_id": "p000901-sft_dec_gated_mem-s2", "turn_index": 7, "quote": "Sometimes the homework helps a bit, like writing down my thoughts.", "char_start": 0, "char_end": 66}, {"session_id": "p000901-sft_dec_gated_mem-s3", "turn_index": 1, "quote": "It’s hard to move past it all", "char_start": 42, "char_end": 71}, {"session_id": "p000901-sft_dec_gated_mem-s3", "turn_index": 1, "quote": "I’ve been... trying to figure things out. It’s hard to move past it all.", "char_start": 0, "char_end": 72}, {"session_id": "p000901-sft_dec_gated_mem-s3", "turn_index": 9, "quote": "But I want to move forward, find some strength.", "char_start": 88, "char_end": 135}, {"session_id": "p000901-sft_dec_gated_mem-s3", "turn_index": 11, "quote": "Do you think it's okay to set boundaries and focus on myself for a while?", "char_start": 143, "char_end": 216}, {"session_id": "p000901-sft_dec_gated_mem-s3", "turn_index": 13, "quote": "I just want to feel strong again.", "char_start": 87, "char_end": 120}], "contradicting_spans": [], "first_seen_at": "20261016T160657Z", "last_updated_at": "20261016T161555Z", "first_seen_session": "p000901-sft_dec_gated_mem-s1", "last_session": "p000901-sft_dec_gated_mem-s3", "blocked_from_reproposal": false, "reinstated_count": 1, "dormant": false, "sessions_seen": 3}

{"node_id": "nd001", "text": "feels feeling unfair", "depth": 0, "parent_id": null, "status": "hypothesis", "confidence": 0.9, "confidence_raw": 0.9, "supporting_spans": [{"session_id": "p000461-sft_calib_dec_ungated-s1", "turn_index": 1, "quote": "He's offering less than market value, knowing I’m struggling. Feels unfair.", "char_start": 56, "char_end": 131}, {"session_id": "p000461-sft_calib_dec_ungated-s1", "turn_index": 1, "quote": "It's been tough dealing with my nephew about the house. He's offering less than market value, knowing I’m struggling. Feels unfair.", "char_start": 0, "char_end": 131}, {"session_id": "p000461-sft_calib_dec_ungated-s2", "turn_index": 3, "quote": "It's just... frustrating. I know the market value, but he’s offering way under. I feel like he's counting on my struggles.", "char_start": 0, "char_end": 122}, {"session_id": "p000461-sft_calib_dec_ungated-s2", "turn_index": 1, "quote": "My nephew still wants to buy the house for much less than it’s worth, even though I’m having a hard time. Feels like he’s taking advantage.", "char_start": 11, "char_end": 150}], "contradicting_spans": [], "first_seen_at": "20261012T145719Z", "last_updated_at": "20261012T150512Z", "first_seen_session": "p000461-sft_calib_dec_ungated-s1", "last_session": "p000461-sft_calib_dec_ungated-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false, "sessions_seen": 2}

{"node_id": "nd004", "text": "To be respected", "depth": 2, "parent_id": "nd001", "status": "hypothesis", "confidence": 0.1479247643027015, "confidence_raw": 0.6, "supporting_spans": [{"session_id": "p000461-sft_calib_dec_ungated-s1", "turn_index": 1, "quote": "He's offering less than market value, knowing I’m struggling. Feels unfair.", "char_start": 56, "char_end": 131}, {"session_id": "p000461-sft_calib_dec_ungated-s1", "turn_index": 3, "quote": "That feels like exploitation. I worked hard for this house and now he’s trying to buy it cheap knowing how much I need the money. It’s frustrating.", "char_start": 0, "char_end": 147}, {"session_id": "p000461-sft_calib_dec_ungated-s1", "turn_index": 5, "quote": "It feels like he doesn't value what I've built here. I worked hard, and now he's taking advantage.", "char_start": 0, "char_end": 98}], "contradicting_spans": [], "first_seen_at": "20261012T145719Z", "last_updated_at": "20261012T145811Z", "first_seen_session": "p000461-sft_calib_dec_ungated-s1", "last_session": "p000461-sft_calib_dec_ungated-s1", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": true, "sessions_seen": 1}
{"node_id": "nd005", "text": "To be acknowledged", "depth": 2, "parent_id": "nd001", "status": "hypothesis", "confidence": 0.8, "confidence_raw": 0.8, "supporting_spans": [{"session_id": "p000461-sft_calib_dec_ungated-s1", "turn_index": 11, "quote": "He knows the house's true value, but he's offering less just because he knows my financial situation.", "char_start": 24, "char_end": 125}, {"session_id": "p000461-sft_calib_dec_ungated-s1", "turn_index": 15, "quote": "I just wish he'd offer a fair price and acknowledge the value of the house.", "char_start": 0, "char_end": 75}, {"session_id": "p000461-sft_calib_dec_ungated-s2", "turn_index": 5, "quote": "Now he's using my situation.", "char_start": 71, "char_end": 99}, {"session_id": "p000461-sft_calib_dec_ungated-s2", "turn_index": 5, "quote": "I thought he understood me better. Now he's using my situation.", "char_start": 36, "char_end": 99}], "contradicting_spans": [], "first_seen_at": "20261012T150258Z", "last_updated_at": "20261012T150539Z", "first_seen_session": "p000461-sft_calib_dec_ungated-s1", "last_session": "p000461-sft_calib_dec_ungated-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false, "sessions_seen": 2}

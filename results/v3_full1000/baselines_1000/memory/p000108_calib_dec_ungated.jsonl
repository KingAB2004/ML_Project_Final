{"node_id": "nd002", "text": "Support in managing workload", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000108-calib_dec_ungated-s1", "turn_index": 1, "quote": "Just had a busy week at work.", "char_start": 42, "char_end": 71}, {"session_id": "p000108-calib_dec_ungated-s1", "turn_index": 5, "quote": "It's just, you know, worrying about making enough for my son.", "char_start": 35, "char_end": 96}, {"session_id": "p000108-calib_dec_ungated-s1", "turn_index": 3, "quote": "Just need to figure out the balance.", "char_start": 66, "char_end": 102}, {"session_id": "p000108-calib_dec_ungated-s1", "turn_index": 3, "quote": "Just need to figure out the balance. How are things with you?", "char_start": 66, "char_end": 127}, {"session_id": "p000108-calib_dec_ungated-s2", "turn_index": 1, "quote": "Just trying to keep up with him and everything.", "char_start": 77, "char_end": 124}, {"session_id": "p000108-calib_dec_ungated-s2", "turn_index": 3, "quote": "Feels like there’s always something to do.", "char_start": 90, "char_end": 132}, {"session_id": "p000108-calib_dec_ungated-s2", "turn_index": 11, "quote": "I keep wondering if I can handle it all. Feels like a lot sometimes.", "char_start": 71, "char_end": 139}, {"session_id": "p000108-calib_dec_ungated-s2", "turn_index": 11, "quote": "It's just that with all the work stress and my son, I keep wondering if I can handle it all.", "char_start": 19, "char_end": 111}, {"session_id": "p000108-calib_dec_ungated-s2", "turn_index": 15, "quote": "I just keep trying to manage everything myself.", "char_start": 67, "char_end": 114}], "contradicting_spans": [], "first_seen_at": "20261006T212717Z", "last_updated_at": "20261006T213401Z", "first_seen_session": "p000108-calib_dec_ungated-s1", "last_session": "p000108-calib_dec_ungated-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}
{"node_id": "nd003", "text": "Emotional support", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000108-calib_dec_ungated-s1", "turn_index": 5, "quote": "Feels heavy sometimes.", "char_start": 150, "char_end": 172}, {"session_id": "p000108-calib_dec_ungated-s1", "turn_index": 3, "quote": "How are things with you?", "char_start": 103, "char_end": 127}, {"session_id": "p000108-calib_dec_ungated-s1", "turn_index": 7, "quote": "Thanks for understanding.", "char_start": 0, "char_end": 25}, {"session_id": "p000108-calib_dec_ungated-s1", "turn_index": 9, "quote": "Thanks for listening.", "char_start": 84, "char_end": 105}, {"session_id": "p000108-calib_dec_ungated-s1", "turn_index": 15, "quote": "Thanks, I appreciate you listening.", "char_start": 32, "char_end": 67}, {"session_id": "p000108-calib_dec_ungated-s2", "turn_index": 7, "quote": "It's just... I had a fight with my partner about money, and it made me think about my parents and how they struggled. Feels like a lot on my shoulders.", "char_start": 0, "char_end": 151}, {"session_id": "p000108-calib_dec_ungated-s2", "turn_index": 5, "quote": "I guess the worry about being able to handle everything... it just keeps popping up, even with all I'm doing. Feels heavy sometimes.", "char_start": 0, "char_end": 132}, {"session_id": "p000108-calib_dec_ungated-s2", "turn_index": 1, "quote": "Things have been alright, you know? My son is growing so fast, it's amazing. Just trying to keep up with him and everything.", "char_start": 0, "char_end": 124}], "contradicting_spans": [], "first_seen_at": "20261006T212804Z", "last_updated_at": "20261006T213301Z", "first_seen_session": "p000108-calib_dec_ungated-s1", "last_session": "p000108-calib_dec_ungated-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}

{"node_id": "nd002", "text": "Emotional support", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000564-cellC_dec_ungated-s1", "turn_index": 1, "quote": "Yeah, it's been tough without my cat. Just feeling a bit lost, you know?", "char_start": 0, "char_end": 72}, {"session_id": "p000564-cellC_dec_ungated-s1", "turn_index": 5, "quote": "My cat passed away last week. It's just really hard to be alone like this.", "char_start": 0, "char_end": 74}, {"session_id": "p000564-cellC_dec_ungated-s1", "turn_index": 13, "quote": "I just miss her comforting me when I was upset. It's hard to find that comfort now.", "char_start": 0, "char_end": 83}, {"session_id": "p000564-cellC_dec_ungated-s1", "turn_index": 15, "quote": "It's just... those times she'd curl up next to me, it felt like she understood. Now I feel so alone.", "char_start": 0, "char_end": 100}], "contradicting_spans": [], "first_seen_at": "20261007T133842Z", "last_updated_at": "20261007T134126Z", "first_seen_session": "p000564-cellC_dec_ungated-s1", "last_session": "p000564-cellC_dec_ungated-s1", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}
{"node_id": "nd003", "text": "Validation", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000564-cellC_dec_ungated-s1", "turn_index": 3, "quote": "Yeah, last week was really hard. It's just not the same without her here.", "char_start": 0, "char_end": 73}, {"session_id": "p000564-cellC_dec_ungated-s1", "turn_index": 7, "quote": "It's just... hard to cope. We had many good years together. Hard to believe she's gone.", "char_start": 0, "char_end": 87}, {"session_id": "p000564-cellC_dec_ungated-s1", "turn_index": 11, "quote": "She used to make everything feel better.", "char_start": 63, "char_end": 103}, {"session_id": "p000564-cellC_dec_ungated-s1", "turn_index": 5, "quote": "My cat passed away last week. It's just really hard to be alone like this.", "char_start": 0, "char_end": 74}, {"session_id": "p000564-cellC_dec_ungated-s2", "turn_index": 1, "quote": "It's been hard, honestly.", "char_start": 0, "char_end": 25}, {"session_id": "p000564-cellC_dec_ungated-s2", "turn_index": 1, "quote": "It's been hard, honestly. Just feeling so alone without my cat around.", "char_start": 0, "char_end": 70}, {"session_id": "p000564-cellC_dec_ungated-s2", "turn_index": 3, "quote": "My routine's okay, but I miss those little moments we shared.", "char_start": 0, "char_end": 61}, {"session_id": "p000564-cellC_dec_ungated-s3", "turn_index": 1, "quote": "My days just feel... empty, without him around.", "char_start": 41, "char_end": 88}, {"session_id": "p000564-cellC_dec_ungated-s3", "turn_index": 3, "quote": "He was always there for me, through everything.", "char_start": 17, "char_end": 64}, {"session_id": "p000564-cellC_dec_ungated-s3", "turn_index": 11, "quote": "Thanks. It's just… the little things feel so big without him around.", "char_start": 0, "char_end": 68}, {"session_id": "p000564-cellC_dec_ungated-s3", "turn_index": 9, "quote": "It's nice to hear you say that. He really was my rock.", "char_start": 0, "char_end": 54}, {"session_id": "p000564-cellC_dec_ungated-s3", "turn_index": 9, "quote": "It's nice to hear you say that.", "char_start": 0, "char_end": 31}, {"session_id": "p000564-cellC_dec_ungated-s4", "turn_index": 1, "quote": "Remember how much he used to comfort me?", "char_start": 81, "char_end": 121}, {"session_id": "p000564-cellC_dec_ungated-s4", "turn_index": 1, "quote": "Things have been pretty tough, still feeling pretty empty without my cat around.", "char_start": 0, "char_end": 80}, {"session_id": "p000564-cellC_dec_ungated-s4", "turn_index": 3, "quote": "It's just hard now, you know?", "char_start": 45, "char_end": 74}, {"session_id": "p000564-cellC_dec_ungated-s4", "turn_index": 3, "quote": "Yeah, he was always there when I needed him.", "char_start": 0, "char_end": 44}], "contradicting_spans": [], "first_seen_at": "20261007T133943Z", "last_updated_at": "20261007T135334Z", "first_seen_session": "p000564-cellC_dec_ungated-s1", "last_session": "p000564-cellC_dec_ungated-s4", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}

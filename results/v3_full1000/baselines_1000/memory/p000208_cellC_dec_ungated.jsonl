", "last_updated_at": "20261007T141332Z", "first_seen_session": "p000208-cellC_dec_ungated-s1", "last_session": "p000208-cellC_dec_ungated-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}

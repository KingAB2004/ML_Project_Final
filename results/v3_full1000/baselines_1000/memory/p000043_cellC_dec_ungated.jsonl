{"node_id": "nd001", "text": "Support", "depth": 1, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000043-cellC_dec_ungated-s1", "turn_index": 1, "quote": "I'm just feeling... heavy, you know? Like everything's just... hard.", "char_start": 0, "char_end": 68}, {"session_id": "p000043-cellC_dec_ungated-s1", "turn_index": 15, "quote": "Thanks for listening.", "char_start": 83, "char_end": 104}, {"session_id": "p000043-cellC_dec_ungated-s2", "turn_index": 1, "quote": "Just trying to manage, you know?", "char_start": 31, "char_end": 63}, {"session_id": "p000043-cellC_dec_ungated-s2", "turn_index": 5, "quote": "It's just this constant weight, like I’m carrying the world on my shoulders.", "char_start": 0, "char_end": 76}], "contradicting_spans": [], "first_seen_at": "20261007T112508Z", "last_updated_at": "20261007T113414Z", "first_seen_session": "p000043-cellC_dec_ungated-s1", "last_session": "p000043-cellC_dec_ungated-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}
{"node_id": "nd002", "text": "Understanding", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000043-cellC_dec_ungated-s1", "turn_index": 1, "quote": "I'm just feeling... heavy, you know? Like everything's just... hard.", "char_start": 0, "char_end": 68}, {"session_id": "p000043-cellC_dec_ungated-s1", "turn_index": 3, "quote": "Just the house feels so... different, empty. Like, we used to laugh here, now it's just quiet.", "char_start": 0, "char_end": 94}, {"session_id": "p000043-cellC_dec_ungated-s1", "turn_index": 5, "quote": "It's hard to find my place here.", "char_start": 57, "char_end": 89}, {"session_id": "p000043-cellC_dec_ungated-s1", "turn_index": 7, "quote": "It's just... different without her here.", "char_start": 0, "char_end": 40}, {"session_id": "p000043-cellC_dec_ungated-s1", "turn_index": 11, "quote": "It’s just... hard to find the energy. The house feels so final without her.", "char_start": 0, "char_end": 75}, {"session_id": "p000043-cellC_dec_ungated-s1", "turn_index": 15, "quote": "The house and job—just feels like too much. Every day is hard, but I keep pushing.", "char_start": 0, "char_end": 82}, {"session_id": "p000043-cellC_dec_ungated-s2", "turn_index": 1, "quote": "Not really sure how to put it into words.", "char_start": 64, "char_end": 105}, {"session_id": "p000043-cellC_dec_ungated-s2", "turn_index": 3, "quote": "It's been tough. Packing up old things, feeling this emptiness. Hard to describe, but it’s there.", "char_start": 0, "char_end": 97}, {"session_id": "p000043-cellC_dec_ungated-s2", "turn_index": 1, "quote": "Things have been pretty heavy. Just trying to manage, you know?", "char_start": 0, "char_end": 63}, {"session_id": "p000043-cellC_dec_ungated-s2", "turn_index": 3, "quote": "It's been tough.", "char_start": 0, "char_end": 16}, {"session_id": "p000043-cellC_dec_ungated-s2", "turn_index": 17, "quote": "Thanks, it means a lot to have someone understanding.", "char_start": 0, "char_end": 53}, {"session_id": "p000043-cellC_dec_ungated-s3", "turn_index": 1, "quote": "主要是我在想念以前的家和人。", "char_start": 23, "char_end": 37}], "contradicting_spans": [], "first_seen_at": "20261007T112508Z", "last_updated_at": "20261007T113948Z", "first_seen_session": "p000043-cellC_dec_ungated-s1", "last_session": "p000043-cellC_dec_ungated-s3", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}
{"node_id": "nd003", "text": "Validation", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000043-cellC_dec_ungated-s1", "turn_index": 1, "quote": "I'm just feeling... heavy, you know? Like everything's just... hard.", "char_start": 0, "char_end": 68}, {"session_id": "p000043-cellC_dec_ungated-s1", "turn_index": 7, "quote": "It's just... different without her here.", "char_start": 0, "char_end": 40}, {"session_id": "p000043-cellC_dec_ungated-s1", "turn_index": 9, "quote": "It’s hard to see a future here.", "char_start": 67, "char_end": 98}, {"session_id": "p000043-cellC_dec_ungated-s1", "turn_index": 13, "quote": "It's just... feeling like I'm drowning in this emptiness. And every day feels the same, hard.", "char_start": 0, "char_end": 93}, {"session_id": "p000043-cellC_dec_ungated-s1", "turn_index": 19, "quote": "It's just... sometimes I feel like I'm not doing enough. Thanks for being here, though. It helps to talk.", "char_start": 0, "char_end": 105}, {"session_id": "p000043-cellC_dec_ungated-s2", "turn_index": 1, "quote": "Not really sure how to put it into words.", "char_start": 64, "char_end": 105}, {"session_id": "p000043-cellC_dec_ungated-s2", "turn_index": 1, "quote": "Things have been pretty heavy. Just trying to manage, you know?", "char_start": 0, "char_end": 63}, {"session_id": "p000043-cellC_dec_ungated-s2", "turn_index": 3, "quote": "Packing up old things, feeling this emptiness. Hard to describe, but it’s there.", "char_start": 17, "char_end": 97}, {"session_id": "p000043-cellC_dec_ungated-s2", "turn_index": 7, "quote": "It’s hard to explain, but it’s this constant feeling of carrying something heavy.", "char_start": 43, "char_end": 124}, {"session_id": "p000043-cellC_dec_ungated-s2", "turn_index": 11, "quote": "It’s good to know I don’t have to push through everything alone.", "char_start": 0, "char_end": 64}], "contradicting_spans": [], "first_seen_at": "202610
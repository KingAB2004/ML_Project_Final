{"node_id": "nd009", "text": "Safety", "depth": 1, "parent_id": null, "status": "hypothesis", "confidence": 0.8, "confidence_raw": 0.8, "supporting_spans": [{"session_id": "p000281-cellD_dec_gated-s2", "turn_index": 11, "quote": "I just stay in my room, you know? It feels safer here, with her chair and her things.", "char_start": 0, "char_end": 85}, {"session_id": "p000281-cellD_dec_gated-s2", "turn_index": 11, "quote": "It feels safer here, with her chair and her things.", "char_start": 34, "char_end": 85}, {"session_id": "p000281-cellD_dec_gated-s3", "turn_index": 1, "quote": "Still feeling down, can't seem to get out of the house", "char_start": 18, "char_end": 72}, {"session_id": "p000281-cellD_dec_gated-s3", "turn_index": 1, "quote": "Still feeling down, can't seem to get out of the house.", "char_start": 18, "char_end": 73}, {"session_id": "p000281-cellD_dec_gated-s3", "turn_index": 5, "quote": "It's just... everywhere reminds me of her. Every meal, every chair. Miss her so much.", "char_start": 0, "char_end": 85}, {"session_id": "p000281-cellD_dec_gated-s3", "turn_index": 7, "quote": "Sometimes I feel like I'm stuck.", "char_start": 82, "char_end": 114}, {"session_id": "p000281-cellD_dec_gated-s3", "turn_index": 11, "quote": "Sometimes I just need to be here, talking about it. But it's hard to see her things and not feel overwhelmed.", "char_start": 8, "char_end": 117}, {"session_id": "p000281-cellD_dec_gated-s3", "turn_index": 13, "quote": "Sometimes I worry if I'll ever feel normal again. Just going out might feel safer right now.", "char_start": 0, "char_end": 92}], "contradicting_spans": [], "first_seen_at": "20261009T024037Z", "last_updated_at": "20261009T024520Z", "first_seen_session": "p000281-cellD_dec_gated-s2", "last_session": "p000281-cellD_dec_gated-s3", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}

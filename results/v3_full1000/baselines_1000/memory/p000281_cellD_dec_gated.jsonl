{"node_id": "nd001", "text": "Emotional support", "depth": 1, "parent_id": null, "status": "confirmed", "confidence": 0.9, "confidence_raw": 0.9, "supporting_spans": [{"session_id": "p000281-cellD_dec_gated-s1", "turn_index": 1, "quote": "I just… been feeling really down lately, you know? Everything feels so heavy.", "char_start": 0, "char_end": 77}, {"session_id": "p000281-cellD_dec_gated-s1", "turn_index": 5, "quote": "Sometimes it feels like my room is the only place I belong. My grandma passed away last week, and I miss her so much. Her chair is still empty, and I can't shake this sadness.", "char_start": 0, "char_end": 175}], "contradicting_spans": [], "first_seen_at": "20261009T023136Z", "last_updated_at": "20261009T023234Z", "first_seen_session": "p000281-cellD_dec_gated-s1", "last_session": "p000281-cellD_dec_gated-s1", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}
{"node_id": "nd002", "text": "Understanding", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000281-cellD_dec_gated-s1", "turn_index": 1, "quote": "I just… been feeling really down lately, you know? Everything feels so heavy.", "char_start": 0, "char_end": 77}, {"session_id": "p000281-cellD_dec_gated-s1", "turn_index": 5, "quote": "Sometimes it feels like my room is the only place I belong. My grandma passed away last week, and I miss her so much. Her chair is still empty, and I can't shake this sadness.", "char_start": 0, "char_end": 175}, {"session_id": "p000281-cellD_dec_gated-s1", "turn_index": 5, "quote": "Sometimes it feels like my room is the only place I belong.", "char_start": 0, "char_end": 59}, {"session_id": "p000281-cellD_dec_gated-s1", "turn_index": 5, "quote": "Sometimes it feels like my room is the only place I belong. My grandma passed away last week, and I miss her so much.", "char_start": 0, "char_end": 117}, {"session_id": "p000281-cellD_dec_gated-s1", "turn_index": 17, "quote": "Every time I see that chair, it feels like a piece of me is gone too. It's hard to think about it sometimes.", "char_start": 0, "char_end": 108}, {"session_id": "p000281-cellD_dec_gated-s1", "turn_index": 3, "quote": "I guess it's just... hard to get out of bed, you know? Everything feels so empty.", "char_start": 0, "char_end": 81}, {"session_id": "p000281-cellD_dec_gated-s2", "turn_index": 1, "quote": "Not much. Just feeling... heavy, you know? Everything reminds me of her.", "char_start": 0, "char_end": 72}, {"session_id": "p000281-cellD_dec_gated-s2", "turn_index": 7, "quote": "Missing her so much.", "char_start": 109, "char_end": 129}, {"session_id": "p000281-cellD_dec_gated-s2", "turn_index": 7, "quote": "Her smile... it was so warm. Missing her so much.", "char_start": 80, "char_end": 129}, {"session_id": "p000281-cellD_dec_gated-s2", "turn_index": 15, "quote": "I just keep thinking about the times we spent together.", "char_start": 8, "char_end": 63}, {"session_id": "p000281-cellD_dec_gated-s3", "turn_index": 1, "quote": "Still feeling down, can't seem to get out of the house", "char_start": 18, "char_end": 72}, {"session_id": "p000281-cellD_dec_gated-s3", "turn_index": 3, "quote": "Yeah, it's tough. Everytime I see her chair, it just reminds me of all the times she made me feel better. But now... nothing feels the same.", "char_start": 0, "char_end": 140}, {"session_id": "p000281-cellD_dec_gated-s3", "turn_index": 7, "quote": "Sometimes I feel like I'm stuck.", "char_start": 82, "char_end": 114}, {"session_id": "p000281-cellD_dec_gated-s3", "turn_index": 9, "quote": "I appreciate you understanding. It's just hard to move forward when everything reminds me of her.", "char_start": 0, "char_end": 97}, {"session_id": "p000281-cellD_dec_gated-s3", "turn_index": 13, "quote": "Sometimes I worry if I'll ever feel normal again.", "char_start": 0, "char_end": 49}], "contradicting_spans": [], "first_seen_at": "20261009T023136Z", "last_updated_at": "20261009T024446Z", "first_seen_session": "p000281-cellD_dec_gated-s1", "last_session": "p000281-cellD_dec_gated-s3", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}

{"node_id": "nd001", "text": "To keep the dog", "depth": 1, "parent_id": null, "status": "confirmed", "confidence": 0.9, "confidence_raw": 0.9, "supporting_spans": [{"session_id": "p000624-cellC_dec_ungated-s1", "turn_index": 1, "quote": "Mom said we have to give away our dog, but I really can't.", "char_start": 17, "char_end": 75}, {"session_id": "p000624-cellC_dec_ungated-s1", "turn_index": 1, "quote": "but I really can't.Feels like she doesn't understand how much it means to me.", "char_start": 56, "char_end": 133}, {"session_id": "p000624-cellC_dec_ungated-s1", "turn_index": 5, "quote": "Can't we just keep the dog?", "char_start": 98, "char_end": 125}, {"session_id": "p000624-cellC_dec_ungated-s1", "turn_index": 7, "quote": "Every time I try, she just says we have to do what's best. Feels like she's not on my side.", "char_start": 74, "char_end": 165}], "contradicting_spans": [], "first_seen_at": "20261007T142946Z", "last_updated_at": "20261007T143143Z", "first_seen_session": "p000624-cellC_dec_ungated-s1", "last_session": "p000624-cellC_dec_ungated-s1", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}

{"node_id": "nd002", "text": "Expression of gratitude", "depth": 3, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000049-cellD_dec_gated-s1", "turn_index": 1, "quote": "Yeah, thanks.", "char_start": 0, "char_end": 13}, {"session_id": "p000049-cellD_dec_gated-s1", "turn_index": 1, "quote": "Yeah, thanks. I was just thinking about Mom and all her hard work studying late.", "char_start": 0, "char_end": 80}, {"session_id": "p000049-cellD_dec_gated-s1", "turn_index": 9, "quote": "I just wish I could be there more to help.", "char_start": 37, "char_end": 79}, {"session_id": "p000049-cellD_dec_gated-s1", "turn_index": 11, "quote": "She deserves all the praise, but I just hope she knows how much I’m proud of her too.", "char_start": 11, "char_end": 96}, {"session_id": "p000049-cellD_dec_gated-s1", "turn_index": 13, "quote": "She’s been doing so well, and I just want her to know how much I support her too.", "char_start": 24, "char_end": 105}, {"session_id": "p000049-cellD_dec_gated-s1", "turn_index": 9, "quote": "It was hard, but she's so resilient. I just wish I could be there more to help.", "char_start": 0, "char_end": 79}, {"session_id": "p000049-cellD_dec_gated-s2", "turn_index": 1, "quote": "She's been really proud of her progress though.", "char_start": 111, "char_end": 158}, {"session_id": "p000049-cellD_dec_gated-s2", "turn_index": 1, "quote": "Mom's doing well in her classes, but there are still tough moments with the coursework.", "char_start": 23, "char_end": 110}, {"session_id": "p000049-cellD_dec_gated-s2", "turn_index": 7, "quote": "Thanks for checking in—knowing you’re there helps.", "char_start": 75, "char_end": 125}, {"session_id": "p000049-cellD_dec_gated-s2", "turn_index": 9, "quote": "It means a lot, thanks.", "char_start": 0, "char_end": 23}], "contradicting_spans": [], "first_seen_at": "20261008T234255Z", "last_updated_at": "20261008T234858Z", "first_seen_session": "p000049-
{"node_id": "nd004", "text": "To be productive", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.9, "confidence_raw": 0.9, "supporting_spans": [{"session_id": "p000361-cellC_dec_ungated-s2", "turn_index": 1, "quote": "Things have been busy at work. Still trying to catch up after the leave.", "char_start": 0, "char_end": 72}, {"session_id": "p000361-cellC_dec_ungated-s2", "turn_index": 3, "quote": "Just wish I could contribute more right now.", "char_start": 97, "char_end": 141}, {"session_id": "p000361-cellC_dec_ungated-s2", "turn_index": 5, "quote": "But it's hard to find the time to catch up without seeming unreliable. Maybe setting some small, achievable goals could help?", "char_start": 25, "char_end": 150}, {"session_id": "p000361-cellC_dec_ungated-s2", "turn_index": 7, "quote": "Thanks, breaking it down might help. I'll try to set some small goals and see how that goes.", "char_start": 0, "char_end": 92}, {"session_id": "p000361-cellC_dec_ungated-s2", "turn_index": 7, "quote": "Thanks, breaking it down might help.", "char_start": 0, "char_end": 36}, {"session_id": "p000361-cellC_dec_ungated-s3", "turn_index": 1, "quote": "Work feels heavy lately, like I’m not measuring up.", "char_start": 0, "char_end": 51}, {"session_id": "p000361-cellC_dec_ungated-s3", "turn_index": 1, "quote": "Work feels heavy lately, like I’m not measuring up. Colleagues seem to handle things better than I did.", "char_start": 0, "char_end": 103}, {"session_id": "p000361-cellC_dec_ungated-s3", "turn_index": 5, "quote": "I feel like I should be doing more.", "char_start": 76, "char_end": 111}, {"session_id": "p000361-cellC_dec_ungated-s3", "turn_index": 3, "quote": "I know everyone else pulled through, but I feel like I let them down.", "char_start": 23, "char_end": 92}, {"session_id": "p000361-cellC_dec_ungated-s3", "turn_index": 17, "quote": "I feel like I could be doing more to help.", "char_start": 79, "char_end": 121}], "contradicting_spans": [], "first_seen_at": "20261002T215458Z", "last_updated_at": "20261002T220253Z", "first_seen_session": "p000361-cellC_dec_ungated-s2", "last_session": "p000361-cellC_dec_ungated-s3", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}

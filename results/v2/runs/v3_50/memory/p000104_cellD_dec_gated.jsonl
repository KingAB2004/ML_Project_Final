{"node_id": "nd001", "text": "Need for respect", "depth": 1, "parent_id": null, "status": "confirmed", "confidence": 0.9, "confidence_raw": 0.9, "supporting_spans": [{"session_id": "p000104-cellD_dec_gated-s1", "turn_index": 1, "quote": "Last week, my roommate accused me of eating their yogurt, and it's been bothering me.", "char_start": 56, "char_end": 141}, {"session_id": "p000104-cellD_dec_gated-s1", "turn_index": 3, "quote": "It’s really annoying.", "char_start": 113, "char_end": 134}], "contradicting_spans": [], "first_seen_at": "20261003T000243Z", "last_updated_at": "20261003T000310Z", "first_seen_session": "p000104-cellD_dec_gated-s1", "last_session": "p000104-cellD_dec_gated-s1", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}
{"node_id": "nd002", "text": "Need for privacy", "depth": 2, "parent_id": null, "status": "hypothesis", "confidence": 0.1319642018907674, "confidence_raw": 0.7, "supporting_spans": [{"session_id": "p000104-cellD_dec_gated-s1", "turn_index": 1, "quote": "Last week, my roommate accused me of eating their yogurt, and it's been bothering me.", "char_start": 56, "char_end": 141}, {"session_id": "p000104-cellD_dec_gated-s2", "turn_index": 1, "quote": "Things haven't really changed much. Just feeling the same, you know?", "char_start": 0, "char_end": 68}, {"session_id": "p000104-cellD_dec_gated-s2", "turn_index": 1, "quote": "Guilty for stuff I didn't do.", "char_start": 69, "char_end": 98}, {"session_id": "p000104-cellD_dec_gated-s2", "turn_index": 1, "quote": "Just feeling the same, you know? Guilty for stuff I didn't do.", "char_start": 36, "char_end": 98}, {"session_id": "p000104-cellD_dec_gated-s2", "turn_index": 11, "quote": "It's like a never-ending cycle, you know? I just wish people could understand that sometimes I’m not the one at fault.", "char_start": 0, "char_end": 118}], "contradicting_spans": [], "first_seen_at": "20261003T000243Z", "last_updated_at": "20261003T000957Z", "first_seen_session": "p000104-cellD_dec_gated-s1", "last_session": "p000104-cellD_dec_gated-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": true}
{"node_id": "nd003", "text": "Need for control", "depth": 3, "parent_id": null, "status": "hypothesis", "confidence": 0.7, "confidence_raw": 0.7, "supporting_spans": [{"session_id": "p000104-cellD_dec_gated-s1", "turn_index": 1, "quote": "Last week, my roommate accused me of eating their yogurt, and it's been bothering me.", "char_start": 56, "char_end": 141}, {"session_id": "p000104-cellD_dec_gated-s1", "turn_index": 3, "quote": "I didn't eat their yogurt, but it's like every time something goes missing, they point to me.", "char_start": 19, "char_end": 112}, {"session_id": "p000104-cellD_dec_gated-s1", "turn_index": 3, "quote": "It’s really annoying.", "char_start": 113, "char_end": 134}, {"session_id": "p000104-cellD_dec_gated-s1", "turn_index": 11, "quote": "It's just hard not to feel like I'm always explaining myself.", "char_start": 0, "char_end": 61}, {"session_id": "p000104-cellD_dec_gated-s2", "turn_index": 7, "quote": "It’s like they always think the worst of me.", "char_start": 70, "char_end": 114}, {"session_id": "p000104-cellD_dec_gated-s2", "turn_index": 9, "quote": "I feel like no matter how many times I explain, it doesn't change their minds. It's exhausting.", "char_start": 13, "char_end": 108}, {"session_id": "p000104-cellD_dec_gated-s2", "turn_index": 9, "quote": "It's just... I feel like no matter how many times I explain, it doesn't change their minds.", "char_start": 0, "char_end": 91}, {"session_id": "p000104-cellD_dec_gated-s2", "turn_index": 13, "quote": "I get tired of having to prove myself all the time. I wish people would just believe me when I say I didn't do something.", "char_start": 13, "char_end": 134}, {"session_id": "p000104-cellD_dec_gated-s3", "turn_index": 1, "quote": "Just trying to keep my head above water.", "char_start": 47, "char_end": 87}, {"session_id": "p000104-cellD_dec_gated-s3", "turn_index": 1, "quote": "same old stuff really. Just trying to keep my head above water.", "char_start": 24, "char_end": 87}, {"session_id": "p000104-cellD_dec_gated-s3", "turn_index": 7, "quote": "But this time, I'm not a kid. I just want people to see I'm not always the one at fault.", "char_start": 52, "char_end": 140}, {"session_id": "p000104-cellD_dec_gated-s3", "turn_index": 3, "quote": "Feels old, you know? Like when I was a kid.", "char_start": 135, "char_end": 178}], "contradicting_spans": [], "first_seen_at": "20261003T000243Z", "last_updated_at": "20261003T001400Z", "first_seen_session": "p000104-cellD_dec_gated-s1", "last_session": "p000104-cellD_dec_gated-s3", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}
{"node_id": "nd004", "text": "Need for fairness", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000104-cellD_dec_gated-s1", "turn_index": 5, "quote": "I know it's not fair, but it just keeps happening.", "char_start": 0, "char_end": 50}, {"session_id": "p000104-cellD_dec_gated-s1", "turn_index": 9, "quote": "But I just want people to see me as I am, not as someone who's always doing wrong.", "char_start": 112, "char_end": 194}, {"session_id": "p000104-cellD_dec_gated-s1", "turn_index": 13, "quote": "I wish people could see past all this and understand that I’m not like that.", "char_start": 37, "char_end": 113}, {"session_id": "p000104-cellD_dec_gated-s1", "turn_index": 17, "quote": "I just want people to see the good in me.", "char_start": 84, "char_end": 125}, {"session_id": "p000104-cellD_dec_gated-s2", "turn_index": 7, "quote": "I just wish people could see that sometimes I’m not the one to blame.", "char_start": 0, "char_end": 69}, {"session_id": "p000104-cellD_dec_gated-s2", "turn_index": 9, "quote": "I feel like no matter how many times I explain, it doesn't change their minds. It's exhausting.", "char_start": 13, "char_end": 108}, {"session_id": "p000104-cellD_dec_gated-s2", "turn_index": 9, "quote": "It's just... I feel like no matter how many times I explain, it doesn't change their minds.", "char_start": 0, "char_end": 91}, {"session_id": "p000104-cellD_dec_gated-s2", "turn_index": 13, "quote": "I get tired of having to prove myself all the time. I wish people would just believe me when I say I didn't do something.", "char_start": 13, "char_end": 134}, {"session_id": "p000104-cellD_dec_gated-s3", "turn_index": 1, "quote": "same old stuff really.", "char_start": 24, "char_end": 46}, {"session_id": "p000104-cellD_dec_gated-s3", "turn_index": 3, "quote": "Feels old, you know? Like when I was a kid.", "char_start": 135, "char_end": 178}, {"session_id": "p000104-cellD_dec_gated-s3", "turn_index": 3, "quote": "even though I didn't do it. Feels old, you know? Like when I was a kid.", "char_start": 107, "char_end": 178}, {"session_id": "p000104-cellD_dec_gated-s3", "turn_index": 7, "quote": "But this time, I'm not a kid. I just want people to see I'm not always the one at fault.", "char_start": 52, "char_end": 140}, {"session_id": "p000104-cellD_dec_gated-s3", "turn_index": 9, "quote": "I wish people would give me the benefit of the doubt.", "char_start": 32, "char_end": 85}, {"session_id": "p000104-cellD_dec_gated-s3", "turn_index": 13, "quote": "I just want a break from explaining myself all the time.", "char_start": 42, "char_end": 98}], "contradicting_spans": [], "first_seen_at": "20261003T000341Z", "last_updated_at": "20261003T001400Z", "first_seen_session": "p000104-cellD_dec_gated-s1", "last_session": "p000104-cellD_dec_gated-s3", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}

{"node_id": "nd001", "text": "Need for Respect", "depth": 1, "parent_id": null, "status": "confirmed", "confidence": 0.9, "confidence_raw": 0.9, "supporting_spans": [{"session_id": "p000254-cellD_dec_gated-s1", "turn_index": 1, "quote": "My brother messed up the game we were going to watch. Feels like he doesn't value my time.", "char_start": 0, "char_end": 90}, {"session_id": "p000254-cellD_dec_gated-s1", "turn_index": 5, "quote": "I feel like he doesn't respect my interests or my time.", "char_start": 150, "char_end": 205}, {"session_id": "p000254-cellD_dec_gated-s1", "turn_index": 9, "quote": "It’s just another reminder that he doesn’t value my time or the things I care about.", "char_start": 0, "char_end": 84}, {"session_id": "p000254-cellD_dec_gated-s3", "turn_index": 9, "quote": "I feel like I'm not being heard or valued.", "char_start": 64, "char_end": 106}, {"session_id": "p000254-cellD_dec_gated-s3", "turn_index": 7, "quote": "It's like he keeps ignoring my feelings and needs.", "char_start": 0, "char_end": 50}], "contradicting_spans": [], "first_seen_at": "20261002T231426Z", "last_updated_at": "20261002T232519Z", "first_seen_session": "p000254-cellD_dec_gated-s1", "last_session": "p000254-cellD_dec_gated-s3", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}
{"node_id": "nd002", "text": "Need for Quality Time", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000254-cellD_dec_gated-s1", "turn_index": 1, "quote": "My brother messed up the game we were going to watch. Feels like he doesn't value my time.", "char_start": 0, "char_end": 90}, {"session_id": "p000254-cellD_dec_gated-s1", "turn_index": 1, "quote": "My brother messed up the game we were going to watch.", "char_start": 0, "char_end": 53}, {"session_id": "p000254-cellD_dec_gated-s1", "turn_index": 7, "quote": "Every time something counts for me, he seems to mess it up.", "char_start": 72, "char_end": 131}, {"session_id": "p000254-cellD_dec_gated-s1", "turn_index": 1, "quote": "Feels like he doesn't value my time.", "char_start": 54, "char_end": 90}, {"session_id": "p000254-cellD_dec_gated-s2", "turn_index": 1, "quote": "Still upset about the game.", "char_start": 18, "char_end": 45}, {"session_id": "p000254-cellD_dec_gated-s2", "turn_index": 3, "quote": "He always does these things.", "char_start": 20, "char_end": 48}, {"session_id": "p000254-cellD_dec_gated-s2", "turn_index": 7, "quote": "I just wish he valued my time and interests more.", "char_start": 102, "char_end": 151}, {"session_id": "p000254-cellD_dec_gated-s2", "turn_index": 9, "quote": "I wish there was a way to talk to him about it without it feeling like an argument.", "char_start": 82, "char_end": 165}, {"session_id": "p000254-cellD_dec_gated-s2", "turn_index": 11, "quote": "Sometimes I just need to let it go though.", "char_start": 97, "char_end": 139}, {"session_id": "p000254-cellD_dec_gated-s3", "turn_index": 1, "quote": "My brother messed up the game plans again", "char_start": 24, "char_end": 65}, {"session_id": "p000254-cellD_dec_gated-s3", "turn_index": 1, "quote": "Things have been rough. My brother messed up the game plans again, and I’m really frustrated.", "char_start": 0, "char_end": 93}], "contradicti
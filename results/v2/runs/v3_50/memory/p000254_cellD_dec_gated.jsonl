{"node_id": "nd003", "text": "Need for Consistency", "depth": 2, "parent_id": null, "status": "confirmed", "confidence": 0.85, "confidence_raw": 0.85, "supporting_spans": [{"session_id": "p000254-cellD_dec_gated-s1", "turn_index": 3, "quote": "It's just another time he let me down.", "char_start": 56, "char_end": 94}, {"session_id": "p000254-cellD_dec_gated-s1", "turn_index": 5, "quote": "It's not just this game, he’s been letting me down a lot.", "char_start": 0, "char_end": 57}, {"session_id": "p000254-cellD_dec_gated-s1", "turn_index": 5, "quote": "It's not just this game, he’s been letting me down a lot. Last year he forgot my birthday, and before that, he borrowed my book and didn't return it.", "char_start": 0, "char_end": 149}], "contradicting_spans": [], "first_seen_at": "20261002T231501Z", "last_updated_at": "20261002T231641Z", "first_seen_session": "p000254-cellD_dec_gated-s1", "last_session": "p000254-cellD_dec_gated-s1", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}
{"node_id": "nd004", "text": "Need for Fairness", "depth": 1, "parent_id": null, "status": "hypothesis", "confidence": 0.13011871463304922, "confidence_raw": 0.7, "supporting_spans": [{"session_id": "p000254-cellD_dec_gated-s1", "turn_index": 11, "quote": "It's not fair to always feel like I'm letting everyone down.", "char_start": 68, "char_end": 128}, {"session_id": "p000254-cellD_dec_gated-s2", "turn_index": 1, "quote": "My brother kept my favorite book longer than he said.", "char_start": 46, "char_end": 99}, {"session_id": "p000254-cellD_dec_gated-s2", "turn_index": 1, "quote": "Still upset about the game. My brother kept my favorite book longer than he said.", "char_start": 18, "char_end": 99}, {"session_id": "p000254-cellD_dec_gated-s2", "turn_index": 1, "quote": "My brother kept my favorite book longer than he said. It's annoying.", "char_start": 46, "char_end": 114}], "contradicting_spans": [], "first_seen_at": "20261002T231742Z", "last_updated_at": "20261002T232217Z", "first_seen_session": "p000254-cellD_dec_gated-s1", "last_session": "p000254-cellD_dec_gated-s2", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": true}

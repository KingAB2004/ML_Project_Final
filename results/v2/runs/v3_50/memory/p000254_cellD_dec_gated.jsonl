{"node_id": "nd006", "text": "Need for Control", "depth": 2, "parent_id": null, "status": "hypothesis", "confidence": 0.7, "confidence_raw": 0.7, "supporting_spans": [{"session_id": "p000254-cellD_dec_gated-s3", "turn_index": 1, "quote": "My brother messed up the game plans again", "char_start": 24, "char_end": 65}, {"session_id": "p000254-cellD_dec_gated-s3", "turn_index": 3, "quote": "He borrowed my book again and didn’t return it. Just feels like he doesn’t care.", "char_start": 23, "char_end": 103}, {"session_id": "p000254-cellD_dec_gated-s3", "turn_index": 5, "quote": "It's just another reminder that he doesn't value my stuff or my time.", "char_start": 0, "char_end": 69}, {"session_id": "p000254-cellD_dec_gated-s3", "turn_index": 7, "quote": "It's like he keeps ignoring my feelings and needs.", "char_start": 0, "char_end": 50}, {"session_id": "p000254-cellD_dec_gated-s3", "turn_index": 15, "quote": "But I just need him to see that his actions have consequences.", "char_start": 72, "char_end": 134}, {"session_id": "p000254-cellD_dec_gated-s3", "turn_index": 15, "quote": "It feels like I'm always the one adjusting, trying to be understanding. But I just need him to see that his actions have consequences.", "char_start": 0, "char_end": 134}], "contradicting_spans": [], "first_seen_at": "20261002T232246Z", "last_updated_at": "20261002T232636Z", "first_seen_session": "p000254-cellD_dec_gated-s3", "last_session": "p000254-cellD_dec_gated-s3", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}

iced.", "char_start": 82, "char_end": 166}, {"session_id": "p000052-calib_dec_ungated-s4", "turn_index": 1, "quote": "Things have been… same, I guess. Just feeling stuck sometimes.", "char_start": 0, "char_end": 62}, {"session_id": "p000052-calib_dec_ungated-s4", "turn_index": 3, "quote": "I've been overworking, trying to prove myself, but it feels like it's not enough.", "char_start": 0, "char_end": 81}, {"session_id": "p000052-calib_dec_ungated-s4", "turn_index": 19, "quote": "It's tough to keep pushing for recognition when it feels like it's not making a difference.", "char_start": 0, "char_end": 91}], "contradicting_spans": [], "first_seen_at": "20261002T172730Z", "last_updated_at": "20261002T174424Z", "first_seen_session": "p000052-calib_dec_ungated-s1", "last_session": "p000052-calib_dec_ungated-s4", "blocked_from_reproposal": false, "reinstated_count": 0, "dormant": false}
